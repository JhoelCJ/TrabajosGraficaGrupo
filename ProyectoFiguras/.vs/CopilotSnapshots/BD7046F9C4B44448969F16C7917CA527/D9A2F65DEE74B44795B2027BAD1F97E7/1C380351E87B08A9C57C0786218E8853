using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows.Forms;

namespace ProyectoFiguras
{
    public partial class Form1 : Form
    {
        Figura figuraActual = null;
        private string figuraSeleccionada = "Kite";


        public Form1()
        {
            InitializeComponent();
        }

        private void Form1_Load(object sender, EventArgs e)
        {
            SetFiguraSeleccionada(figuraSeleccionada);
        }

        private void SetFiguraSeleccionada(string nombre)
        {
            figuraSeleccionada = nombre;
            label5.Text = "Figura: " + figuraSeleccionada;

            if (figuraSeleccionada == "Hexagon")
            {
                lblValor1.Text = "Ingrese el valor del lado";
            }
            else
            {
                lblValor1.Text = "Valor 1";
            }

            if (figuraSeleccionada == "Octagon" ||
                figuraSeleccionada == "Hexagon" ||
                figuraSeleccionada == "Pie" ||
                figuraSeleccionada == "Crescent" ||
                figuraSeleccionada == "Heart" ||
                figuraSeleccionada == "Trefoil")
            {
                txtValor2.Visible = false;
                lblValor2.Visible = false;
            }
            else
            {
                txtValor2.Visible = true;
                lblValor2.Visible = true;
            }
        }

        private void mnuKite_Click(object sender, EventArgs e)
        {
            SetFiguraSeleccionada("Kite");
        }

        private void mnuOctagon_Click(object sender, EventArgs e)
        {
            SetFiguraSeleccionada("Octagon");
        }

        private void mnuHexagon_Click(object sender, EventArgs e)
        {
            SetFiguraSeleccionada("Hexagon");
        }

        private void mnuPie_Click(object sender, EventArgs e)
        {
            SetFiguraSeleccionada("Pie");
        }

        private void mnuCrescent_Click(object sender, EventArgs e)
        {
            SetFiguraSeleccionada("Crescent");
        }

        private void mnuHeart_Click(object sender, EventArgs e)
        {
            SetFiguraSeleccionada("Heart");
        }

        private void mnuRhombus_Click(object sender, EventArgs e)
        {
            SetFiguraSeleccionada("Rhombus");
        }

        private void mnuTrefoil_Click(object sender, EventArgs e)
        {
            SetFiguraSeleccionada("Trefoil");
        }

        private void btnDibujar_Click(object sender, EventArgs e)
        {
            double v1, v2 = 0;

            if (!double.TryParse(txtValor1.Text, out v1) || v1 <= 0)
            {
                MessageBox.Show(
                    figuraSeleccionada == "Hexagon" ? "Lado inválido" :
                    figuraSeleccionada == "Crescent" ? "Diámetro inválido" :
                    "Valor 1 inválido");
                return;
            }

            if (txtValor2.Visible)
            {
                if (!double.TryParse(txtValor2.Text, out v2) || v2 <= 0)
                {
                    MessageBox.Show("Valor 2 inválido");
                    return;
                }
            }

            switch (figuraSeleccionada)
            {
                case "Kite":
                    figuraActual = new Kite(v1, v2);
                    break;
                case "Octagon":
                    figuraActual = new Octagon(v1);
                    break;
                case "Hexagon":
                    figuraActual = new Hexagon(v1);
                    break;
                case "Pie":
                    figuraActual = new Pie(v1);
                    break;
                case "Crescent":
                    figuraActual = new Crescent(v1);
                    break;
                case "Heart":
                    figuraActual = new Heart(v1);
                    break;
                case "Rhombus":
                    figuraActual = new Rhombus(v1, v2);
                    break;
                case "Trefoil":
                    figuraActual = new Trefoil(v1);
                    break;
            }

            lblArea.Text = "Área: " + figuraActual.Area().ToString("0.00");
            lblPerimetro.Text = "Perímetro: " + figuraActual.Perimetro().ToString("0.00");

            tabControl1.SelectedTab = tabGrafica;
            pnlDibujo.Invalidate();
        }

        private void pnlDibujo_Paint(object sender, PaintEventArgs e)
        {
            if (figuraActual != null)
            {
                figuraActual.Dibujar(e.Graphics, pnlDibujo.Width, pnlDibujo.Height);
            }
        }

        private void mnuPoligonosIrregulares_Click(object sender, EventArgs e)
        {

        }

        private void lblValor1_Click(object sender, EventArgs e)
        {

        }
    }
}
