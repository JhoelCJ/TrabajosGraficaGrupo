using System;
using System.Drawing;
using System.Windows.Forms;

namespace ProyectoFiguras
{
    public class MensajeBienvenida
    {
        public static void MostrarBienvenida(Panel panel)
        {
            if (panel.Width <= 0 || panel.Height <= 0)
                return;

            // Crear un Bitmap para dibujar el mensaje de bienvenida
            Bitmap bmp = new Bitmap(panel.Width, panel.Height);

            using (Graphics g = Graphics.FromImage(bmp))
            {
                // Llenar con color blanco
                g.Clear(Color.White);

                // Configurar la fuente y el color del texto
                using (Font fuente = new Font("Arial", 24, FontStyle.Bold))
                using (Brush pincel = new SolidBrush(Color.DarkBlue))
                {
                    // Calcular la posición del texto en el centro
                    string mensaje = "¡Bienvenido!";
                    SizeF tamaño = g.MeasureString(mensaje, fuente);
                    float x = (panel.Width - tamaño.Width) / 2;
                    float y = (panel.Height - tamaño.Height) / 2;

                    // Dibujar el mensaje
                    g.DrawString(mensaje, fuente, pincel, x, y);
                }
            }

            // Mostrar la imagen en el panel
            if (panel.BackgroundImage != null)
                panel.BackgroundImage.Dispose();
            panel.BackgroundImage = bmp;
            panel.BackgroundImageLayout = ImageLayout.None;
        }

        public static void LimpiarPanel(Panel panel)
        {
            if (panel.BackgroundImage != null)
            {
                panel.BackgroundImage.Dispose();
                panel.BackgroundImage = null;
            }
        }
    }
}
