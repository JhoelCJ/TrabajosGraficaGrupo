                lblValor2.Visible = true;
                txtValor2.Visible = true;
                txtValor2.Clear();
            }
            else
            {
                lblValor2.Visible = false;
                txtValor2.Visible = false;
            }

            // Mostrar el botón y reiniciar etiquetas
