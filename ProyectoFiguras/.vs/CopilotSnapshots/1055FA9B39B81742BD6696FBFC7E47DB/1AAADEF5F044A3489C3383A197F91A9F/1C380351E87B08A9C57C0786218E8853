        private void btnDibujar_Click(object sender, EventArgs e)
        {
            if (string.IsNullOrEmpty(figuraSeleccionada))
            {
                MessageBox.Show("Por favor, seleccione una figura del menú primero.");
                return;
            }

            try
            {
                // Validación básica para campos visibles
                float valor1 = 0;
                float valor2 = 0;

                if (txtValor1.Visible && !float.TryParse(txtValor1.Text, out valor1))
                {
                    MessageBox.Show("Por favor, ingrese un número válido en el Valor 1.");
                    return;
                }

                if (txtValor2.Visible && !float.TryParse(txtValor2.Text, out valor2))
                {
                    MessageBox.Show("Por favor, ingrese un número válido en el Valor 2.");
                    return;
                }

                // Forzar redibujo del panel
                pnlDibujo.Invalidate();
            }
            catch (Exception ex)
            {
                MessageBox.Show("Error: " + ex.Message);
            }
        }

        private void pnlDibujo_Paint(object sender, PaintEventArgs e)
        {
            // Limpiar fondo
            e.Graphics.Clear(Color.White);
            e.Graphics.SmoothingMode = System.Drawing.Drawing2D.SmoothingMode.AntiAlias;

            if (string.IsNullOrEmpty(figuraSeleccionada)) return;

            // Obtener valores seguros (si ocurre error se omite el dibujo calladamente aquí 
            // ya que btnDibujar_Click muestra el messagebox)
            float v1 = 0, v2 = 0;
            if (txtValor1.Visible) float.TryParse(txtValor1.Text, out v1);
            if (txtValor2.Visible) float.TryParse(txtValor2.Text, out v2);

            // Evitar dibujar con tamaño cero si un valor requerido no se ingresó o es 0
            if (txtValor1.Visible && v1 <= 0) return;

            Pen pen = new Pen(Color.Blue, 2);
            SolidBrush defaultBrush = new SolidBrush(Color.YellowGreen); // Cambiado a YellowGreen por defecto para todas las figuras

            int cx = pnlDibujo.Width / 2;
            int cy = pnlDibujo.Height / 2;

            // En un caso real usaríamos Factoría e instancias específicas de clases derivadas Figura
            // Aquí dibujamos algo representativo para cada selección
            switch (figuraSeleccionada)
            {
                case "Octagon":
                    DibujarPoligonoRegular(e.Graphics, pen, defaultBrush, 8, v1, cx, cy);
                    lblArea.Text = $"Area: {Math.Round(2 * (1 + Math.Sqrt(2)) * v1 * v1, 2)}";
                    lblPerimetro.Text = $"Perimetro: {Math.Round(8 * v1, 2)}";
                    break;
                case "Hexagon":
                    DibujarPoligonoRegular(e.Graphics, pen, defaultBrush, 6, v1, cx, cy);
                    lblArea.Text = $"Area: {Math.Round((3 * Math.Sqrt(3) / 2) * v1 * v1, 2)}";
                    lblPerimetro.Text = $"Perimetro: {Math.Round(6 * v1, 2)}";
                    break;
                case "Semicircle":
                    e.Graphics.FillPie(defaultBrush, cx - v1, cy - v1, v1 * 2, v1 * 2, 0, -180);
                    // e.Graphics.DrawArc(pen, cx - v1, cy - v1, v1 * 2, v1 * 2, 0, -180); Lineas de contorno apagadas
                    // e.Graphics.DrawLine(pen, cx - v1, cy, cx + v1, cy);
                    lblArea.Text = $"Area: {Math.Round((Math.PI * v1 * v1)/2, 2)}";
                    lblPerimetro.Text = $"Perimetro: {Math.Round(Math.PI * v1 + 2*v1, 2)}";
                    break;
                case "Rhombus":
                    DibujarRombo(e.Graphics, pen, defaultBrush, v1, v2, cx, cy);
                    lblArea.Text = $"Area: {Math.Round((v1 * v2) / 2, 2)}";
                    lblPerimetro.Text = $"Perimetro: {Math.Round(4 * Math.Sqrt(Math.Pow(v1 / 2, 2) + Math.Pow(v2 / 2, 2)), 2)}";
                    break;
                case "Kite":
                    DibujarCometa(e.Graphics, pen, defaultBrush, v1, v2, cx, cy);
                    lblArea.Text = $"Area: {Math.Round((v1 * v2) / 2, 2)}";
                    float ladoCorto = (float)Math.Sqrt(Math.Pow(v1/2, 2) + Math.Pow(v2/4, 2));
                    float ladoLargo = (float)Math.Sqrt(Math.Pow(v1/2, 2) + Math.Pow(3*v2/4, 2));
                    lblPerimetro.Text = $"Perimetro: {Math.Round(2 * (ladoCorto + ladoLargo), 2)}";
                    break;
                case "Heart":
                    DibujarCorazon(e.Graphics, pen, defaultBrush, v1, cx, cy);
                    lblArea.Text = $"Area: {Math.Round(v1 * v1 + Math.PI * Math.Pow(v1/2, 2), 2)}";
                    lblPerimetro.Text = $"Perimetro: {Math.Round(2 * v1 + Math.PI * v1, 2)}";
                    break;
                case "Trefoil":
                    DibujarTrebol(e.Graphics, pen, defaultBrush, v1, cx, cy);
                    lblArea.Text = $"Area: {Math.Round(3 * Math.PI * Math.Pow(v1 / 4f, 2), 2)}";
                    lblPerimetro.Text = $"Perimetro: {Math.Round(6 * Math.PI * (v1 / 4f), 2)}";
                    break;
                case "Cross":
                    DibujarCruz(e.Graphics, pen, defaultBrush, v1, cx, cy);
                    lblArea.Text = $"Area: {Math.Round(5 * v1 * v1, 2)}";
                    lblPerimetro.Text = $"Perimetro: {Math.Round(12 * v1, 2)}";
                    break;
                case "Pie":
                    e.Graphics.FillPie(defaultBrush, cx - v1, cy - v1, v1 * 2, v1 * 2, 0, v2);
                    // e.Graphics.DrawPie(pen, cx - v1, cy - v1, v1 * 2, v1 * 2, 0, v2); Lineas de contorno apagado
                    lblArea.Text = $"Area: {Math.Round((v2 / 360) * Math.PI * v1 * v1, 2)}";
                    lblPerimetro.Text = $"Perimetro: {Math.Round((v2 / 360) * 2 * Math.PI * v1 + 2 * v1, 2)}";
                    break;
                case "Crescent":
                    DibujarCrecienteAproximado(e.Graphics, pen, defaultBrush, v1, v2, cx, cy);
                    lblArea.Text = $"Area: {Math.Round(Math.PI * Math.Pow(v1/2, 2) * 0.4, 2)} (aprox)"; 
                    lblPerimetro.Text = $"Perimetro: {Math.Round(Math.PI * v1 * 0.8, 2)} (aprox)";
                    break;
                // ...existing cases...
            }

            // Re-declaramos y limpiamos las dependencias finales del Brush principal
            pen.Dispose();
            defaultBrush.Dispose();
        }

        // Metodo auxiliar para dibujar poligonos regulares
        private void DibujarPoligonoRegular(Graphics g, Pen pen, Brush brush, int lados, float ladoLength, int cx, int cy)
        {
            PointF[] puntos = new PointF[lados];
            // Radio de la circunferencia circunscrita
            float R = (float)(ladoLength / (2 * Math.Sin(Math.PI / lados))); 

            for (int i = 0; i < lados; i++)
            {
                double angulo = 2 * Math.PI * i / lados - Math.PI / 2; // -PI/2 para empezar arriba
                puntos[i] = new PointF(
                    cx + (float)(R * Math.Cos(angulo)),
                    cy + (float)(R * Math.Sin(angulo))
                );
            }
            g.FillPolygon(brush, puntos);
            g.DrawPolygon(pen, puntos);
        }

        private void DibujarRombo(Graphics g, Pen pen, Brush brush, float dMayor, float dMenor, int cx, int cy)
        {
            PointF[] puntos = {
                new PointF(cx, cy - dMayor / 2),
                new PointF(cx + dMenor / 2, cy),
                new PointF(cx, cy + dMayor / 2),
                new PointF(cx - dMenor / 2, cy)
            };
            g.FillPolygon(brush, puntos);
            g.DrawPolygon(pen, puntos);
        }

        private void DibujarCometa(Graphics g, Pen pen, Brush brush, float dHorizontal, float dVertical, int cx, int cy)
        {
            PointF[] puntos = {
                new PointF(cx, cy - dVertical / 4), // Arriba (más corto)
                new PointF(cx + dHorizontal / 2, cy), // Derecha
                new PointF(cx, cy + 3 * dVertical / 4), // Abajo (más largo)
                new PointF(cx - dHorizontal / 2, cy) // Izquierda
            };
            g.FillPolygon(brush, puntos);
            g.DrawPolygon(pen, puntos);
        }

        private void DibujarCruz(Graphics g, Pen pen, Brush brush, float anchoEscala, int cx, int cy)
        {
            float a = anchoEscala;
            PointF[] puntos = {
                new PointF(cx - a/2, cy - a*1.5f), new PointF(cx + a/2, cy - a*1.5f),
                new PointF(cx + a/2, cy - a/2), new PointF(cx + a*1.5f, cy - a/2),
                new PointF(cx + a*1.5f, cy + a/2), new PointF(cx + a/2, cy + a/2),
                new PointF(cx + a/2, cy + a*1.5f), new PointF(cx - a/2, cy + a*1.5f),
                new PointF(cx - a/2, cy + a/2), new PointF(cx - a*1.5f, cy + a/2),
                new PointF(cx - a*1.5f, cy - a/2), new PointF(cx - a/2, cy - a/2)
            };
            g.FillPolygon(brush, puntos);
            g.DrawPolygon(pen, puntos);
        }

        private void DibujarCorazon(Graphics g, Pen pen, Brush brush, float a, int cx, int cy)
        {
            System.Drawing.Drawing2D.GraphicsPath path = new System.Drawing.Drawing2D.GraphicsPath();
            float halfA = a / 2;
            path.AddArc(cx - a, cy - a, a, a, 135, 180);
            path.AddArc(cx, cy - a, a, a, 225, 180);
            path.AddLine(cx + a, cy - halfA, cx, cy + a);
            path.AddLine(cx, cy + a, cx - a, cy - halfA);
            path.CloseFigure();

            g.FillPath(brush, path);
            g.DrawPath(pen, path);
        }

        private void DibujarTrebol(Graphics g, Pen pen, Brush brush, float v1, int cx, int cy)
        {
            // Ajustamos el tamaño del radio directamente basado en v1, limitándolo para que no sobrepase el panel
            float R = Math.Min(v1 / 3f, Math.Min(cx, cy) / 2f);

            // Distancia del centro del panel a los centros de los círculos para que queden equitativos
            // Esto hace que la intersección sea justa en el medio y formen la silueta idéntica de la figura
            float offset = R * 0.85f; 

            // Círculo Arriba
            float x1 = cx - R;
            float y1 = cy - R - offset;

            // Círculo Abajo Izquierda
            // Mueve el centro a la izquierda y hacia abajo usando trigonometría a 150 grados (o aprox)
            float x2 = cx - R - (float)(Math.Cos(Math.PI / 6) * offset);
            float y2 = cy - R + (float)(Math.Sin(Math.PI / 6) * offset);

            // Círculo Abajo Derecha
            // Mueve el centro a la derecha y hacia abajo
            float x3 = cx - R + (float)(Math.Cos(Math.PI / 6) * offset);
            float y3 = cy - R + (float)(Math.Sin(Math.PI / 6) * offset);

            using (SolidBrush greenBrush = new SolidBrush(Color.YellowGreen))
            {
                // Usar Path + Region une las figuras
                System.Drawing.Drawing2D.GraphicsPath path = new System.Drawing.Drawing2D.GraphicsPath();
                path.AddEllipse(x1, y1, R * 2, R * 2);
                path.AddEllipse(x2, y2, R * 2, R * 2);
                path.AddEllipse(x3, y3, R * 2, R * 2);

                g.FillPath(greenBrush, path);

                path.Dispose();
            }
        }

        private void DibujarCrecienteAproximado(Graphics g, Pen pen, Brush brush, float diametro, float distancia, int cx, int cy)
        {
            if (diametro <= 0) return;

            float R = diametro / 2f;
            float offset = (distancia <= 0 || distancia > diametro) ? R * 0.6f : distancia;

            System.Drawing.Drawing2D.GraphicsPath pathCirculoBase = new System.Drawing.Drawing2D.GraphicsPath();
            pathCirculoBase.AddEllipse(cx - R, cy - R, diametro, diametro);

            System.Drawing.Drawing2D.GraphicsPath pathRecorte = new System.Drawing.Drawing2D.GraphicsPath();
            pathRecorte.AddEllipse(cx - R, cy - R - offset, diametro, diametro);

            using (Region regionCreciente = new Region(pathCirculoBase))
            {
                regionCreciente.Exclude(pathRecorte);
                g.FillRegion(new SolidBrush(Color.Orange), regionCreciente); // Dejamos la luna naranja pura
            }

            pathCirculoBase.Dispose();
            pathRecorte.Dispose();
        }

        private void DibujarLuna(Graphics g, Pen pen, Brush brush, float R, float dist, int cx, int cy)
        {
            // Usamos un GraphicsPath para representar la luna de forma exacta (sin region)
            System.Drawing.Drawing2D.GraphicsPath path = new System.Drawing.Drawing2D.GraphicsPath();

            // Añadimos el círculo mayor
            path.AddEllipse(cx - R, cy - R, R * 2, R * 2);

            // Creamos un segundo GraphicsPath para el círculo superpuesto (el recorte)
            System.Drawing.Drawing2D.GraphicsPath cutout = new System.Drawing.Drawing2D.GraphicsPath();
            // Desplazamos el círculo hacia arriba para crear la forma de U de la luna
            cutout.AddEllipse(cx - R, cy - R - dist, R * 2, R * 2);

            // Creamos una Region a partir del camino principal y le excluimos el camino de recorte
            Region regionLuna = new Region(path);
            regionLuna.Exclude(cutout);

            // Rellenamos solo la región resultante (la luna)
            g.FillRegion(brush, regionLuna);

            // Solo para propositos de visualización limpiamos el brush naranja
            g.FillRegion(Brushes.Orange, regionLuna);

            // Si es necesario, podemos intentar trazar el contorno o dejarlo rellenado como en tu imagen
            // g.DrawPath(pen, path); no se usa para evitar dibujar las líneas no deseadas

            path.Dispose();
            cutout.Dispose();
            regionLuna.Dispose();
        }
