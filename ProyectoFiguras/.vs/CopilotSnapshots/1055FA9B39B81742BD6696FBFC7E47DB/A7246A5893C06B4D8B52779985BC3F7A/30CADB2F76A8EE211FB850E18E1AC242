        private void ActivarControles(string nombreFigura, string nombreValor1, bool requiereDosValores = false, string nombreValor2 = "")
        {
            figuraSeleccionada = nombreFigura;

            // Configurar el primer valor
            lblValor1.Text = nombreValor1 + ":";
            lblValor1.Visible = true;
            txtValor1.Visible = true;
            txtValor1.Clear();

            // Configurar el segundo valor si se requiere
            if (requiereDosValores)
            {
                lblValor2.Text = nombreValor2 + ":";
                lblValor2.Visible = true;
                txtValor2.Visible = true;
                txtValor2.Clear();
            }
            else
            {
                lblValor2.Visible = false;
                txtValor2.Visible = false;
            }

            // Mostrar el botón y reiniciar etiquetas
            btnDibujar.Visible = true;
            lblArea.Text = "Area:";
            lblPerimetro.Text = "Perimetro:";

            // Limpiar el panel
            pnlDibujo.Invalidate();
        }

