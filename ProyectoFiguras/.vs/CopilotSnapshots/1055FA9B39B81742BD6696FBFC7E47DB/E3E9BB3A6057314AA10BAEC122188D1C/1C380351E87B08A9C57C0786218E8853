        private void pnlDibujo_Paint(object sender, PaintEventArgs e)
        {
            if (mostrarBienvenida)
            {
                // Dibujar fondo blanco
                e.Graphics.Clear(Color.White);

                // Configurar la fuente y el color del texto
                using (Font fuente = new Font("Arial", 24, FontStyle.Bold))
                using (Brush pincel = new SolidBrush(Color.DarkBlue))
                {
                    // Calcular la posición del texto en el centro
                    string mensaje = "¡Bienvenido!";
                    SizeF tamaño = e.Graphics.MeasureString(mensaje, fuente);
                    float x = (pnlDibujo.Width - tamaño.Width) / 2;
                    float y = (pnlDibujo.Height - tamaño.Height) / 2;

                    // Dibujar el mensaje
                    e.Graphics.DrawString(mensaje, fuente, pincel, x, y);
                }
            }
        }

        private void MostrarControles(string figura)
