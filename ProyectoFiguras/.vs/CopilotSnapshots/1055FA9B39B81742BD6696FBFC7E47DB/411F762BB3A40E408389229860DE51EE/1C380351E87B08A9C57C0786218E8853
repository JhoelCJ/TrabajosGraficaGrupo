        private void pnlDibujo_Paint(object sender, PaintEventArgs e)
        {
            // Siempre limpiar con blanco
            e.Graphics.Clear(Color.White);

            if (mostrarBienvenida)
            {
                using (Font fuente = new Font("Arial", 32, FontStyle.Bold))
                using (Brush pincel = new SolidBrush(Color.DarkBlue))
                {
                    string mensaje = "¡Bienvenido!";
                    SizeF tamaño = e.Graphics.MeasureString(mensaje, fuente);

                    Panel panel = sender as Panel;
                    if (panel != null)
                    {
                        float x = (panel.Width - tamaño.Width) / 2;
                        float y = (panel.Height - tamaño.Height) / 2;
                        e.Graphics.DrawString(mensaje, fuente, pincel, x, y);
                    }
                }
            }
        }
