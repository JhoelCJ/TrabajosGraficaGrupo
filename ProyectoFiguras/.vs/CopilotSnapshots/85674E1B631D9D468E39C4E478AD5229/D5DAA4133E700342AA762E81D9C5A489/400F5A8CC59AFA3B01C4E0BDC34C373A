using System;
using System.Drawing;

namespace ProyectoFiguras
{
    public class Semicircle : Figura
    {
        private double circunferenciaCompleta;
        private double radio;

        public Semicircle(double circunferenciaCompleta)
        {
            this.circunferenciaCompleta = circunferenciaCompleta;
            // C = 2 * PI * r  => r = C / (2 * PI)
            this.radio = this.circunferenciaCompleta / (2 * Math.PI);
        }

        public override double Area()
        {
            // Area de un semicírculo = (PI * r^2) / 2
            return (Math.PI * radio * radio) / 2;
        }

        public override double Perimetro()
        {
            // Perímetro = longitud del arco + diámetro
            // Longitud del arco = PI * r
            // Diámetro = 2 * r
            return (Math.PI * radio) + (2 * radio);
        }

        public override void Dibujar(Graphics g, int width, int height)
        {
            float centerX = width / 2;
            float centerY = height / 2;
            float diameter = (float)(2 * this.radio);

            // El rectángulo que contiene el semicírculo
            Rectangle rect = new Rectangle((int)(centerX - (diameter / 2)), (int)centerY, (int)diameter, (int)diameter);

            // Dibujar el semicírculo (un "pie" de 180 grados)
            // El ángulo 180 es el inicio (a la izquierda) y 180 es el barrido (hacia abajo y a la derecha)
            g.FillPie(Brushes.Red, rect, 180, 180);
        }
    }
}
